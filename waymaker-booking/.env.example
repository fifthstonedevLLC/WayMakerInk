# ==========================================================================
# WayMaker Ink — Dokploy environment template
#
# Copy the values into the Dokploy environment panel. These are TWO SEPARATE
# APPLICATIONS with separate env panels — the split matters, because the form
# container's config is served to the public and the n8n container's is not.
#
# Nothing here is read from a file at runtime. This is a reference so the
# required set is written down somewhere other than a UI.
# ==========================================================================


# ==========================================================================
# APPLICATION 1 — booking form  (this Dockerfile, domain: booking.waymakerink.com)
# ==========================================================================
# Read by docker-entrypoint.sh at container start and written into
# public/config.js, which is then served to every visitor.
#
# ⚠ Anything set here is PUBLIC. No secrets, no artist email addresses.

# Production intake webhook.
# MUST be /webhook/ — a /webhook-test/ URL accepts exactly one request and only
# while the n8n editor is open, so the form works once and then silently stops
# for everyone else.
WM_WEBHOOK_URL=https://n8n.fifthstonedev.com/webhook/booking-request

# Which artists are live, and how they're named on the page.
# One line, no surrounding quotes. Enabling an artist is an edit here — no code
# change, no image rebuild.
#
# Keys: enabled (bool, required), name (string), headline, blurb.
# Anything omitted falls back to DEFAULT_ARTISTS in public/app.js.
#
# If this fails to parse, the entrypoint logs a warning and the app falls back
# to its built-in defaults rather than serving a broken page — so a typo shows
# up as "Laynie is still disabled", not a blank screen.
WM_ARTISTS={"nic":{"enabled":true,"name":"Nic Sinnwell"},"laynie":{"enabled":false,"name":"Laynie Flugum"}}

# Legacy name for WM_WEBHOOK_URL. Still accepted so an existing Dokploy app
# keeps working; prefer WM_WEBHOOK_URL for new setups.
# WEBHOOK_URL=


# ==========================================================================
# APPLICATION 2 — n8n
# ==========================================================================
# Read inside Code nodes as $env.NAME.
#
# $env is NOT the same as $vars. n8n "Variables" ($vars) is an Enterprise
# feature; $env reads OS environment variables and works on self-hosted
# Community, gated only by N8N_BLOCK_ENV_ACCESS_IN_NODE below.
#
# To confirm which you have, run this in any Code node:
#   return [{ json: { envAvailable: typeof $env !== 'undefined',
#                     canRead: !!($env && $env.PATH) } }];
#
# If $env turns out to be blocked, every file in n8n/nodes/ has a FALLBACK
# block at the top — set the values there instead and nothing else changes.

# --- Required by n8n itself ----------------------------------------------

# Signing uses HMAC-SHA256 via require('crypto'). There is no non-crypto
# fallback; the old 32-bit string hash was forgeable and has been removed.
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Must be false for $env to resolve inside Code nodes.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Required by the workflows -------------------------------------------

# HMAC key for the decision links. Generate with:
#   openssl rand -base64 32
#
# The nodes THROW rather than run while this is the placeholder, so a
# misconfigured deploy fails visibly instead of signing with a known key.
# Rotating it invalidates every request email that hasn't been acted on yet.
WM_SIGNING_SECRET=

# No trailing slash. Used to build the decision link targets.
WM_N8N_BASE_URL=https://n8n.fifthstonedev.com

# Where each artist's request email is sent. The intake node throws on any
# value still starting with REPLACE_, so a request can't run clean through
# Workflow A and mail a non-existent address.
WM_ARTIST_NIC_EMAIL=
WM_ARTIST_LAYNIE_EMAIL=

# --- Optional -------------------------------------------------------------

# Acuity scheduling links, per artist, per tier. Omit to use the map built
# into n8n/nodes/commit.js.
#
# One line, no surrounding quotes. Unlike WM_ARTISTS this is strict: invalid
# JSON THROWS rather than falling back, because a silent fallback here would
# send a client the wrong artist's booking link and still look like success.
#
# ⚠ Both artists currently share the same five appointment-type IDs. Correct
# if Acuity routes by staff member on the booking page; wrong if each artist
# has their own appointment types. Confirm before go-live.
WM_BOOKING_LINKS={"nic":{"tier1":"https://waymakerink.as.me/?appointmentType=94784680","tier2":"https://waymakerink.as.me/?appointmentType=96303330","tier3":"https://waymakerink.as.me/?appointmentType=96303759","tier4":"https://waymakerink.as.me/?appointmentType=96303791","tier5":"https://waymakerink.as.me/?appointmentType=96347556"},"laynie":{"tier1":"https://waymakerink.as.me/?appointmentType=94784680","tier2":"https://waymakerink.as.me/?appointmentType=96303330","tier3":"https://waymakerink.as.me/?appointmentType=96303759","tier4":"https://waymakerink.as.me/?appointmentType=96303791","tier5":"https://waymakerink.as.me/?appointmentType=96347556"}}


# ==========================================================================
# After changing anything here
# ==========================================================================
#   Form container : redeploy (config.js is written at container start)
#   n8n container  : restart, then re-open a Code node to confirm $env resolves
#
# Then walk the smoke test in n8n/BUILD-SHEET.md. Step 7 (delete &sig= from a
# decision URL — expect a 403) is the one that used to fail.
