# ==========================================================================
# WayMaker Ink — booking form, UAT
#
# The Dokploy environment for the UAT application only. Production's set is in
# ../.env.example and is a SEPARATE panel on a SEPARATE app.
#
# ⚠ Everything here is written into config.js and served to the public. No
# secrets, no artist email addresses. WM_UAT_PASSWORD is the one exception —
# it is read by nginx and never reaches a page — and it is a doormat, not a
# credential. Do not reuse a real password.
# ==========================================================================


# --- Where the form submits -------------------------------------------------
# ⚠ No longer n8n. Requests go to the Supabase `intake` Edge Function.
#
# A RELATIVE path on purpose. nginx proxies /api/intake to
# ${WM_FUNCTIONS_UPSTREAM}/functions/v1/intake, so the browser's POST is
# same-origin: no preflight, no CORS to configure, and — the reason it matters —
# no unreadable response. app.js reads res.ok, and a cross-origin response
# without Access-Control-Allow-Origin makes fetch reject, which the retry path
# treats as a network fault and fires three times while the function processes
# every one. Three rows for one submission.
#
# Leave this as the relative path unless you know why you are changing it.
WM_WEBHOOK_URL=/api/intake

# --- The Supabase project the form writes to --------------------------------
# Project origin only — no path, no trailing slash. The /functions/v1/intake
# part lives in nginx.conf.template.
#
# ⚠ Required. The entrypoint refuses to start without it, deliberately: a form
# that renders and silently drops every request is worse than one that does not
# come up at all.
#
# ⚠ This must be the UAT project, not production's. It is the only thing
# keeping test submissions out of the real request table.
WM_FUNCTIONS_UPSTREAM=https://YOUR-PROJECT-REF.supabase.co

# No anon key here, and none is needed: the `intake` function is deployed with
# verify_jwt = false, so Supabase's gateway does not ask for one. Adding an
# apikey header would turn the POST into a preflighted request and undo the
# whole point of proxying it.

# --- Which artists the UAT page offers --------------------------------------
# Same shape as production. Enable whoever you are testing; UAT is the place to
# turn a switch on early. Keys: enabled (bool, required), name, headline, blurb,
# services.
#
# ⚠ `services` here is ADVISORY — it decides which chips the page renders. The
# authority is the `services` column on the `artists` row in Supabase, and the
# intake function refuses a request filed against an artist who does not offer
# that service. The two should agree; when they do not, the database wins and
# the client sees a rejection they could have been spared.
#
# Recognised values: tattoo, piercing, touchup.
WM_ARTISTS={"nic":{"enabled":true,"name":"Nic Sinnwell","services":["tattoo","touchup"]},"laynie":{"enabled":true,"name":"Laynie Joy","services":["tattoo","piercing","touchup"]}}

# --- Confirmation page ------------------------------------------------------
# 0 switches the auto-return off, which is what you want while testing: the
# confirmation stops navigating away before you have read it.
WM_HOME_URL=https://waymakerink.com
WM_REDIRECT_SECONDS=0

# --- UAT-only ---------------------------------------------------------------

# Text in the red corner flag on every page, including the review and
# confirmation pages n8n renders. Default "UAT".
WM_UAT_LABEL=UAT

# Set to put the whole site behind a browser password prompt. Leave unset for
# an open host — unlisted and noindexed, but anyone with the URL can submit.
# /healthz and the /webhook/ paths are never gated, so artist decision links
# still work from a mail client.
WM_UAT_USER=uat
WM_UAT_PASSWORD=

# X-Robots-Tag. Default "noindex, nofollow". There is no reason to change it.
# WM_ROBOTS_TAG=noindex, nofollow

# --- DNS for the /api/intake proxy ------------------------------------------
# nginx resolves the upstream per request through `resolver`, and that path does
# DNS queries ONLY — it never reads /etc/hosts. 127.0.0.11 is Docker's embedded
# resolver, which exists on the user-defined network Dokploy puts every app on,
# so the default is already right for a Dokploy deploy.
#
# Change it only when running the image outside such a network, where there is
# nothing at 127.0.0.11 and every proxied request 502s.
WM_RESOLVER=127.0.0.11


# ==========================================================================
# NOT set here — and why
# ==========================================================================
# WM_N8N_UPSTREAM is still read by nginx.conf.template for its /webhook/ and
# /webhook-test/ blocks, left over from the retired Workflow A/B/C build. The
# form does not call n8n at all any more — it posts to /api/intake — so those
# blocks are dead config and the variable can stay unset.
#
# No Supabase ANON KEY. The `intake` function is deployed with
# verify_jwt = false, so the gateway does not ask for one, and adding an apikey
# header would make the POST preflighted and undo the point of the proxy.
#
# No signing secret and no n8n webhook URL. Those live on the Supabase
# functions, not here — see ../supabase/.env.example. This app talks to exactly
# one thing: its own /api/intake proxy.
# ==========================================================================
