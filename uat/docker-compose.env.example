# ==========================================================================
# WayMaker Ink — local compose environment
#
#   cp docker-compose.env.example .env
#   docker compose up --build
#
# `.env` is gitignored. This template is not — keep real keys out of it.
#
# Named docker-compose.env.example rather than .env.example deliberately: the
# repo's .gitignore ignores `.env.*` and rescues only `.env.example`, which is
# already taken by the waiver app in this directory.
# ==========================================================================


# --- Which Supabase project ---------------------------------------------------
# Pick ONE of the two blocks below.

# (a) The hosted UAT project. Project Settings -> API.
WM_SUPABASE_URL=https://YOUR-UAT-PROJECT-REF.supabase.co
WM_SUPABASE_ANON_KEY=
WM_FUNCTIONS_UPSTREAM=https://YOUR-UAT-PROJECT-REF.supabase.co

# (b) A fully local stack — `cd supabase && npx supabase start`, which prints
#     the URL and anon key. Note the HOST is host.docker.internal, not
#     127.0.0.1: these values are read from INSIDE a container, where 127.0.0.1
#     is the container itself.
#
#     ⚠ WM_SUPABASE_URL is read by the BROWSER (it lands in config.js), so that
#     one stays 127.0.0.1. WM_FUNCTIONS_UPSTREAM is read by nginx INSIDE the
#     container, so that one is host.docker.internal. They point at the same
#     stack from two different places, which is why they differ.
#
# WM_SUPABASE_URL=http://127.0.0.1:54321
# WM_SUPABASE_ANON_KEY=<printed by `supabase start`>
# WM_FUNCTIONS_UPSTREAM=http://host.docker.internal:54321


# --- Optional -----------------------------------------------------------------

# Where the two apps listen on the host. 8080 is the most contested port on any
# developer's machine — change these rather than hunting whatever owns it.
WM_FORM_PORT=8080
WM_PORTAL_PORT=8081

# Text in the red corner flag on both apps. Empty hides it.
WM_UAT_LABEL=UAT LOCAL

# HTTP basic auth in front of both apps. Unset by default — a password on
# localhost is friction with no threat behind it. Set both to exercise the path
# before deploying somewhere it matters.
#
# ⚠ No colons and no whitespace in either: the htpasswd line is colon
# separated, and a colon silently shifts the split so the password stops
# matching.
WM_UAT_USER=
WM_UAT_PASSWORD=

# DNS for nginx's per-request upstream resolution.
#
# ⚠ Leave this on Docker's embedded resolver. nginx's `resolver` path does DNS
# queries only and never reads /etc/hosts — which is the sole place
# `host.docker.internal` exists. A public resolver therefore cannot resolve a
# local Supabase stack, and every submission fails as a 502 that app.js retries
# three times before giving up.
WM_RESOLVER=127.0.0.11

# Only reached once an n8n mail workflow exists. Harmless until then.
WM_N8N_UPSTREAM=https://n8n.fifthstonedev.com
