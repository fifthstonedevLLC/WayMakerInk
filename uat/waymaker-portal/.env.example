# ==========================================================================
# WayMaker Ink — admin portal, UAT
#
# The Dokploy environment for the portal app. Read by docker-entrypoint.sh at
# container start and written into /config.js.
#
# ⚠ Everything except WM_UAT_PASSWORD is served to the browser. The anon key
# belongs there; the SERVICE ROLE key does not and must never be set on this
# app — the entrypoint refuses to start if it detects one in the anon slot.
# ==========================================================================


# --- Supabase ---------------------------------------------------------------
# Project settings → API. The URL has no trailing slash (the entrypoint strips
# one anyway) and the key is the `anon` / `public` one.
WM_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
WM_SUPABASE_ANON_KEY=

# --- Environment flag -------------------------------------------------------
# Text in the red corner flag. Same shape as the booking form's WM_UAT_LABEL,
# so "which environment am I in" has one answer across both apps. Leave EMPTY
# in production — an unlabelled portal is the live one.
WM_ENV_LABEL=UAT

# --- Optional second lock ---------------------------------------------------
# HTTP basic auth in front of the whole site, on top of the Supabase login.
# Not a substitute for it — this is a shared doormat password whose job is to
# keep an unlisted UAT host out of reach of anyone who stumbles on the name.
WM_UAT_USER=uat
# ⚠ Generate a real one for a public host — this file is committed, so never
# put the live value here. `openssl rand -base64 18`
WM_UAT_PASSWORD=

# X-Robots-Tag. Default "noindex, nofollow" — and it stays that way in
# production too. This page shows client contact details and photographs.
# WM_ROBOTS_TAG=noindex, nofollow


# ==========================================================================
# Set on the FUNCTIONS, not here
# ==========================================================================
# This app's origin — https://portal.waymakerink.com — has to appear in
# WM_ALLOWED_ORIGINS on the Edge Functions, or `respond` refuses the portal's
# cross-origin call and every Send Response fails with an opaque network error.
# See ../supabase/.env.example.
# ==========================================================================
