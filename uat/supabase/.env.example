# ==========================================================================
# WayMaker Ink — Edge Function secrets, UAT
#
# Set with:  npx supabase secrets set --env-file supabase/.env
# List with: npx supabase secrets list
#
# ⚠ SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are NOT here.
# The platform injects all three into every function; setting them by hand is
# rejected, and pasting a service-role key into a file is how it ends up in git.
# ==========================================================================


# --- Where the portal lives -------------------------------------------------
# Used to build the "open this request" link in the artist's notification
# email. No trailing slash.
WM_PORTAL_URL=https://uat-portal.waymakerink.com


# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the functions cross-origin. Empty is
# the correct value for a deploy that sits behind the nginx /api/ proxy, where
# every call is same-origin. Add localhost only while running `vite dev`.
#
# ⚠ Never "*". `respond` takes the artist's JWT, and a wildcard on a
# credentialed endpoint is a session-theft primitive.
#
# The BOOKING app does not belong in this list. Its POST goes through its own
# nginx /api/intake proxy, so the browser sees a same-origin request and never
# sends an Origin header at all. Adding it would be harmless but misleading.
#
# Add http://localhost:5173 alongside the portal origin only while running
# `vite dev`.
WM_ALLOWED_ORIGINS=https://uat-portal.waymakerink.com


# --- n8n --------------------------------------------------------------------
# n8n keeps the mail and nothing else. Two webhooks, both on the UAT paths —
# n8n refuses to activate two workflows on one path, so these must not be
# production's. Nothing about either URL is hardcoded; these two variables are
# the only place they appear.
#
# Unset WM_N8N_NOTIFY_URL to skip the artist notification entirely; intake
# treats an absent value as "not wired up yet" rather than as an error, so the
# database side can be tested end to end before the mail side exists.
WM_N8N_NOTIFY_URL=https://n8n.fifthstonedev.com/webhook/wm-notify-artist-uat
WM_N8N_RESPOND_URL=https://n8n.fifthstonedev.com/webhook/wm-respond-uat

# --- Signing the calls to n8n -----------------------------------------------
# Both webhook URLs are public and make the shop send email. This secret is
# what stops anyone who learns one from using it.
#
# Every call carries X-WM-Timestamp, X-WM-Signed and X-WM-Signature, where the
# signature is HMAC-SHA256 over the timestamp and the fields that decide who is
# mailed and what link they get. That covers three things a static token in a
# header does not: caller identity, payload integrity, and replay.
#
# Generate with: openssl rand -base64 32
#
# ⚠ The SAME value must be set on the n8n container, also as
# WM_N8N_SIGNING_SECRET, and n8n must actually VERIFY it — paste
# ../n8n-portal/verify-signature.js into a Code node immediately after each
# Webhook node. See ../n8n-portal/BUILD-RESPONSE.md.
#
# The functions refuse to send unsigned if this is missing, rather than making
# a call that an n8n whose verify node was also skipped would happily accept.
WM_N8N_SIGNING_SECRET=
