# ==========================================================================
# WayMaker Ink — waiver forms: environment template
# ==========================================================================
#
# Copy these keys into the Dokploy environment panel for the app. This file is
# committed; it must never contain a real value.
#
# There are TWO SEPARATE places environment variables live:
#
#   1. This app's container  — everything in this file.
#   2. The n8n host          — WM_TURNSTILE_SECRET and the Header Auth
#                              credential value (see README.md).
#
# UAT and production each get their own complete set. Sharing WM_FORM_KEY or
# the Turnstile keys between them defeats the point of having two environments.
# ==========================================================================

# --- Required ---------------------------------------------------------------

# Full n8n production webhook URL for the waiver intake workflow.
# Must be /webhook/, not /webhook-test/ — test URLs accept a single request and
# only while the n8n editor is open. The container refuses to start otherwise.
#
#   UAT:  https://n8n.fifthstonedev.com/webhook/<uat-waiver-path>
#   PROD: https://n8n.fifthstonedev.com/webhook/<prod-waiver-path>
WM_WAIVER_WEBHOOK_URL=

# Shared secret. nginx sends it as X-WM-Form-Key on every proxied submission;
# the n8n webhook node's Header Auth credential must hold the same value.
#
# This is what makes the endpoint authenticated: it lives only in the Dokploy
# environment and in n8n, never in the page source, so a request that did not
# come through our proxy cannot produce it.
#
# Generate with:  openssl rand -base64 32
# No quotes, braces, semicolons or whitespace; minimum 20 characters.
WM_FORM_KEY=

# --- Recommended ------------------------------------------------------------

# Cloudflare Turnstile site key for THIS host. Public by design, but
# domain-bound: register uat.forms.waymakerink.com and forms.waymakerink.com
# separately and use each host's own key.
#
# Unset renders no widget, and the workflow's server-side check then rejects
# every submission — a loud failure rather than a silent hole.
WM_TURNSTILE_SITE_KEY=

# --- Optional ---------------------------------------------------------------

# X-Robots-Tag sent on every response. Defaults to "noindex, nofollow", which
# is what UAT should keep — an indexed UAT waiver form puts a fake-data page in
# search results under the shop's name.
#
#   UAT:  leave unset (defaults to noindex, nofollow)
#   PROD: all
WM_ROBOTS_TAG=
