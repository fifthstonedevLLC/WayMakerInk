# Only public/, nginx.conf.template and docker-entrypoint.sh are COPYed, so
# this is mostly belt-and-braces — but it keeps the build context small and
# makes it obvious that documentation and n8n sources are not shipped.

.git
.gitignore
.github

# Documentation and n8n Code node sources. These are reference material that
# gets pasted into the n8n editor; nothing in the image reads them.
README.md
n8n/

# Never let a real environment file into a layer.
.env
.env.*
!.env.example

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
.claude/
